// Hamood Stock — inventory ledger for Hamood TV.
// Business rules (see CLAUDE.md): stock changes ONLY through StockEntry + lines,
// entries are append-only (void = reverse entry), StockLevel is a cache of the ledger.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// MariaDB (Hostinger's web/cloud hosting database; also works on MySQL 8). Connection via
// @prisma/adapter-mariadb, see src/lib/db.ts. Raw SQL in this app is written for MariaDB 10.6+.
datasource db {
  provider = "mysql"
}

// ─── Enums ────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  /// Warehouse manager: full stock rights in assigned warehouses, approves requests there (v2 A1)
  MANAGER
  STAFF
  /// Installation technician: only his own jobs (Phase C)
  TECHNICIAN
  /// Read-only, sees cost and the audit log
  ACCOUNTANT
  VIEWER
}

enum ApprovalKind {
  ENTRY
  VOID
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum WarehouseKind {
  SELLABLE
  DAMAGED
}

enum EntryType {
  IN
  OUT
  TRANSFER_OUT
  TRANSFER_IN
  CORRECTION_IN
  CORRECTION_OUT
  VOID
}

enum EntryReason {
  SUPPLIER_DELIVERY
  CUSTOMER_RETURN
  OPENING_STOCK
  WEBSITE_ORDER
  /// Plan channels-returns: marketplace orders (order number required, sales like WEBSITE_ORDER)
  NOON_ORDER
  AMAZON_ORDER
  DIRECT_SALE
  INSTALLATION
  TRANSFER
  SUPPLIER_RETURN
  DAMAGED_LOST
  CORRECTION
  VOID
}

// ─── Users & warehouses ───────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  name         String   @db.VarChar(100)
  email        String   @unique @db.VarChar(200)
  passwordHash String
  role         Role     @default(VIEWER)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @db.DateTime(3)
  /// Set for new users and after an admin reset: every page sends them to /account/password first.
  mustChangePassword Boolean   @default(false)
  /// Sessions signed in before this moment are no longer valid (password changed or reset).
  passwordChangedAt  DateTime? @db.DateTime(3)
  lastLoginAt        DateTime? @db.DateTime(3)

  /// Warehouses a STAFF or MANAGER user works in. Ignored for other roles.
  warehouses Warehouse[] @relation("UserWarehouses")

  createdEntries StockEntry[] @relation("EntryCreatedBy")
  voidedEntries  StockEntry[] @relation("EntryVoidedBy")
  attachments    Attachment[]
  lineCosts      LineCost[]
  supplierReturnUpdates SupplierReturn[]
  loginEvents    LoginEvent[]
  auditActions   AuditLog[]
  requests       ApprovalRequest[] @relation("RequestedBy")
  productImages  ProductImage[]
  costChanges    ProductCost[]
  decisions      ApprovalRequest[] @relation("DecidedBy")
}

model Warehouse {
  id     String        @id @default(cuid())
  name   String        @unique
  city   String
  kind   WarehouseKind @default(SELLABLE)
  active Boolean       @default(true)

  users   User[]       @relation("UserWarehouses")
  entries StockEntry[]
  levels  StockLevel[]

  reorder       ProductReorder[]
  requests      ApprovalRequest[] @relation("RequestWarehouse")
  otherRequests ApprovalRequest[] @relation("RequestOtherWarehouse")
}

// ─── Catalogue ────────────────────────────────────────────────────────────

model Product {
  id             String        @id @default(cuid())
  /// Model code printed on the box / used on the website, e.g. "HMD-772"
  modelCode      String        @unique
  /// Internal stock-keeping unit (v2 Phase B). Defaults to the model code.
  sku            String        @unique @db.VarChar(64)
  /// For future scanning: unique when set
  barcode        String?       @unique @db.VarChar(64)
  nameEn         String        @db.VarChar(200)
  nameAr         String        @db.VarChar(200)
  /// Free-text extra details ("Other details" on the form)
  variant        String?       @db.VarChar(200)
  /// Structured attributes, all optional and searchable
  sizeRange      String?       @db.VarChar(50)
  colour         String?       @db.VarChar(50)
  maxLoadKg      Int?
  vesa           String?       @db.VarChar(50)
  /// "/api/product-images/<id>" for an uploaded image (ProductImage), or an external https URL
  imageUrl       String?       @db.Text
  imageId        String?
  /// Current unit cost in SAR. Only for roles with cost:view. History in ProductCost.
  cost           Decimal?      @db.Decimal(12, 2)
  /// Selling price in SAR incl. VAT (not secret)
  sellingPrice   Decimal?      @db.Decimal(12, 2)
  /// Default low-stock level (total across active SELLABLE warehouses <= this; 0 = never, Q5).
  /// Per-warehouse levels in ProductReorder take precedence.
  lowStockLevel  Int           @default(0)
  leadTimeDays   Int?
  /// Linked WooCommerce product on hamoodtv.com
  wooProductId   Int?
  wooSku         String?       @db.VarChar(100)
  /// ACTIVE: everything. DISCONTINUED: can't be received, can still leave (Q7). INACTIVE: no stock, no movements (PB1).
  status         ProductStatus @default(ACTIVE)
  defaultSupplierId String?
  createdAt      DateTime      @default(now()) @db.DateTime(3)
  updatedAt      DateTime      @updatedAt @db.DateTime(3)

  image           ProductImage?    @relation("ProductMainImage", fields: [imageId], references: [id], onDelete: Restrict)
  defaultSupplier Supplier?        @relation(fields: [defaultSupplierId], references: [id], onDelete: Restrict)
  lines           StockEntryLine[]
  levels          StockLevel[]
  costs           ProductCost[]
  reorder         ProductReorder[]
  /// One or more categories; position 0 is the main one (plan ui-menu-import-categories, PU2)
  categories      ProductCategory[]

  @@index([status])
}

/// Product categories, managed by ADMIN (PU2). Deactivated when in use, deleted only when unused.
model Category {
  id        String   @id @default(cuid())
  nameEn    String   @unique @db.VarChar(100)
  nameAr    String   @unique @db.VarChar(100)
  active    Boolean  @default(true)
  position  Int      @default(0)
  createdAt DateTime @default(now()) @db.DateTime(3)

  products ProductCategory[]

  @@index([active, position])
}

model ProductCategory {
  productId  String
  categoryId String
  position   Int    @default(0)

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@id([productId, categoryId])
  @@index([categoryId])
}

enum ProductStatus {
  ACTIVE
  DISCONTINUED
  INACTIVE
}

/// Product photos (decision Q3/PB2): resized in the browser, stored in the database, served by /api/product-images/[id].
model ProductImage {
  id          String   @id @default(cuid())
  mimeType    String   @db.VarChar(32)
  /// ≤ 800 px
  data        Bytes    @db.MediumBlob
  /// ≤ 240 px
  thumb       Bytes    @db.MediumBlob
  size        Int
  createdById String
  createdAt   DateTime @default(now()) @db.DateTime(3)

  createdBy User      @relation(fields: [createdById], references: [id], onDelete: Restrict)
  products  Product[] @relation("ProductMainImage")
}

/// Every change of a product's cost (append-only). Source MANUAL = edited on the product; DELIVERY arrives in Phase C.
model ProductCost {
  id          String   @id @default(cuid())
  productId   String
  cost        Decimal? @db.Decimal(12, 2)
  source      String   @db.VarChar(16)
  changedById String
  at          DateTime @default(now()) @db.DateTime(3)

  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  changedBy User    @relation(fields: [changedById], references: [id], onDelete: Restrict)

  @@index([productId, at])
}

/// Reorder level + quantity per product per warehouse (overrides Product.lowStockLevel for that warehouse).
model ProductReorder {
  productId    String
  warehouseId  String
  reorderLevel Int
  reorderQty   Int    @default(0)

  product   Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  @@id([productId, warehouseId])
  @@index([warehouseId])
}

/// Supplier master (v2 Phase B).
model Supplier {
  id            String   @id @default(cuid())
  nameEn        String   @unique @db.VarChar(200)
  nameAr        String?  @db.VarChar(200)
  contactPerson String?  @db.VarChar(100)
  phone         String?  @db.VarChar(30)
  email         String?  @db.VarChar(200)
  city          String?  @db.VarChar(100)
  country       String?  @db.VarChar(100)
  vatNumber     String?  @db.VarChar(30)
  paymentTerms  String?  @db.VarChar(100)
  notes         String?  @db.Text
  active        Boolean  @default(true)
  createdAt     DateTime @default(now()) @db.DateTime(3)

  products Product[]
  entries  StockEntry[]
}

// ─── Ledger ───────────────────────────────────────────────────────────────

/// One stock movement document. Append-only: never updated (except voidedAt/voidedById) or deleted.
model StockEntry {
  id             String      @id @default(cuid())
  /// Human-readable number from Counter, e.g. "IN-000123", "OUT-000456", "TRF-000012", "COR-000005"
  number         String      @unique
  type           EntryType
  reason         EntryReason
  warehouseId    String
  /// Business date of the movement (may differ from createdAt when back-dated)
  entryDate      DateTime    @default(now()) @db.DateTime(3)
  /// Free reference: website order number, invoice number, supplier DN, …
  reference      String?
  customerName   String?
  /// Direct sale: customer's phone (normalised, Western digits)
  customerPhone  String?
  technicianName String?
  supplierName   String?
  /// Supplier master record (Phase B); supplierName keeps the name as it was when saved
  supplierId     String?
  note           String?     @db.Text
  photoUrl       String?
  /// Phase C1 — return reason (customer return) or damage category (damaged/lost), see src/lib/stock/details.ts
  reasonCode     String?     @db.VarChar(32)
  /// Customer return: RESELLABLE | BROKEN | TRASHED (plan channels-returns). TRASHED returns are written off
  /// at once by a DAMAGED_LOST entry whose originalEntryId is the return.
  itemCondition  String?     @db.VarChar(16)
  /// Customer return: where it was sold — WEBSITE | SHOWROOM | NOON | AMAZON (src/lib/stock/details.ts)
  salesChannel   String?     @db.VarChar(16)
  /// Direct sale: CASH | CARD | TRANSFER
  paymentMethod  String?     @db.VarChar(16)
  /// Direct sale: who sold it (defaults to the user saving the entry)
  salesperson    String?     @db.VarChar(100)
  /// Customer return: the sale (OUT entry) the goods came from, when known
  originalEntryId String?
  /// One key per submitted form: a repeated submit (slow connection, retry) returns the entry already saved.
  idempotencyKey String?     @unique @db.VarChar(64)
  /// Transfer pair partner, or (for a VOID entry) the entry being voided
  linkedEntryId  String?
  voidedAt       DateTime?   @db.DateTime(3)
  voidedById     String?
  createdById    String
  createdAt      DateTime    @default(now()) @db.DateTime(3)

  warehouse   Warehouse        @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  supplier    Supplier?        @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  createdBy   User             @relation("EntryCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  voidedBy    User?            @relation("EntryVoidedBy", fields: [voidedById], references: [id], onDelete: Restrict)
  /// onUpdate Restrict: ids never change, and MariaDB needs it for the generated unique-guard columns.
  linkedEntry StockEntry?      @relation("LinkedEntry", fields: [linkedEntryId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  linkedFrom  StockEntry[]     @relation("LinkedEntry")
  lines       StockEntryLine[]
  /// onUpdate Restrict like linkedEntry (ids never change)
  originalEntry StockEntry?    @relation("OriginalEntry", fields: [originalEntryId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  returns       StockEntry[]   @relation("OriginalEntry")
  attachments   EntryAttachment[]
  supplierReturn SupplierReturn?

  voidRequests  ApprovalRequest[] @relation("RequestTarget")
  approvedVia   ApprovalRequest?  @relation("RequestResult")

  @@index([entryDate])
  @@index([warehouseId, entryDate])
  @@index([type, entryDate])
  @@index([createdById])
  @@index([linkedEntryId])
  @@index([reference])
  @@index([supplierId, reference])
  @@index([originalEntryId])
  @@index([reason, reference])
}

model StockEntryLine {
  id        String @id @default(cuid())
  entryId   String
  productId String
  /// Always positive; direction comes from the entry type. Enforced by a CHECK constraint.
  quantity  Int

  entry   StockEntry @relation(fields: [entryId], references: [id], onDelete: Restrict)
  product Product    @relation(fields: [productId], references: [id], onDelete: Restrict)
  cost    LineCost?

  @@index([entryId])
  @@index([productId])
}

/// Cache of the ledger: current quantity per product per warehouse.
/// NEVER write to this table except inside the stock-entry transaction (src/server/stock).
/// quantity >= 0 is enforced by a CHECK constraint.
model StockLevel {
  productId   String
  warehouseId String
  quantity    Int    @default(0)

  product   Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  @@id([productId, warehouseId])
  @@index([warehouseId])
}

/// Sequential counters for entry numbers. key = number prefix ("IN", "OUT", "TRF", "COR", "VOID", "REQ" for approval requests).
model Counter {
  key   String @id
  value Int    @default(0)
}

/// Delivery-note photos. Stored in the database so the app needs no separate file storage (decision Q10).
/// Served to signed-in users by GET /api/attachments/[id]; StockEntry.photoUrl holds that path.
model Attachment {
  id          String   @id @default(cuid())
  mimeType    String
  size        Int
  data        Bytes    @db.MediumBlob
  createdById String
  createdAt   DateTime @default(now()) @db.DateTime(3)

  createdBy User @relation(fields: [createdById], references: [id], onDelete: Restrict)
  entries   EntryAttachment[]
}

// ─── Controls (v2 Phase A) ────────────────────────────────────────────────

/// Every sign-in attempt. Used for the sign-in limits (failed tries per email / IP) and login history.
model LoginEvent {
  id      String   @id @default(cuid())
  userId  String?
  email   String   @db.VarChar(200)
  ip      String?  @db.VarChar(64)
  success Boolean
  /// Why it failed: "password", "inactive", "rateLimited" ("pending" while the password is being checked)
  reason  String?  @db.VarChar(32)
  at      DateTime @default(now()) @db.DateTime(3)

  user User? @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([email, at])
  @@index([ip, at])
  @@index([userId, at])
}

/// Who changed what (products, users, warehouses, settings, approvals). Append-only, only changed fields.
model AuditLog {
  id           String   @id @default(cuid())
  at           DateTime @default(now()) @db.DateTime(3)
  actorId      String
  /// e.g. "product.update", "user.create", "approval.approve"
  action       String   @db.VarChar(64)
  /// product | user | warehouse | setting | approval
  subjectType  String   @db.VarChar(32)
  subjectId    String?
  subjectLabel String?  @db.VarChar(200)
  before       Json?
  after        Json?

  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([at])
  @@index([subjectType, at])
  @@index([actorId, at])
}

/// A correction / damaged-lost entry or a void waiting for a manager or admin (decision V1).
/// Nothing reaches the ledger until it is approved, then the entry is created through createEntry/voidEntry.
model ApprovalRequest {
  id                     String         @id @default(cuid())
  /// REQ-000001
  number                 String         @unique
  kind                   ApprovalKind
  status                 ApprovalStatus @default(PENDING)
  /// Which approval rule applies: correction | damaged | void
  rule                   String         @db.VarChar(32)
  /// Where the stock would change (a transfer void also changes the destination)
  warehouseId            String
  otherWarehouseId       String?
  /// ENTRY: the entry input. VOID: { entryId, reason }
  payload                Json
  units                  Int
  /// Σ quantity × product cost when the request was made; null when no line had a cost
  value                  Decimal?       @db.Decimal(12, 2)
  /// VOID: the entry to void
  targetEntryId          String?
  /// The entry created on approval (for a void: the first VOID entry)
  resultEntryId          String?        @unique
  idempotencyKey         String?        @unique @db.VarChar(64)
  requestedById          String
  requestedAt            DateTime       @default(now()) @db.DateTime(3)
  decidedById            String?
  decidedAt              DateTime?      @db.DateTime(3)
  decisionNote           String?        @db.Text

  warehouse      Warehouse   @relation("RequestWarehouse", fields: [warehouseId], references: [id], onDelete: Restrict)
  otherWarehouse Warehouse?  @relation("RequestOtherWarehouse", fields: [otherWarehouseId], references: [id], onDelete: Restrict)
  /// onUpdate Restrict: MariaDB needs it for the generated pendingVoidOf column (as for linkedEntry).
  targetEntry    StockEntry? @relation("RequestTarget", fields: [targetEntryId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  resultEntry    StockEntry? @relation("RequestResult", fields: [resultEntryId], references: [id], onDelete: Restrict)
  requestedBy    User        @relation("RequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  decidedBy      User?       @relation("DecidedBy", fields: [decidedById], references: [id], onDelete: Restrict)

  @@index([status, requestedAt])
  @@index([requestedById, requestedAt])
  @@index([warehouseId, status])
}

/// App settings edited on /admin/settings, one JSON value per key (validated in src/lib/settings.ts).
model Setting {
  key         String   @id @db.VarChar(64)
  value       Json
  updatedAt   DateTime @updatedAt @db.DateTime(3)
  updatedById String?
}

// ─── Entry details (v2 Phase C1) ──────────────────────────────────────────

/// Unit cost of a supplier-delivery line (decision PC3). Separate from the line so ledger lines stay immutable;
/// entered with the delivery or later ("cost pending"), corrected only with an audit row.
model LineCost {
  lineId      String   @id
  unitCost    Decimal  @db.Decimal(12, 2)
  enteredById String
  enteredAt   DateTime @default(now()) @db.DateTime(3)

  line      StockEntryLine @relation(fields: [lineId], references: [id], onDelete: Restrict)
  enteredBy User           @relation(fields: [enteredById], references: [id], onDelete: Restrict)
}

/// Photos of an entry (up to 5); StockEntry.photoUrl keeps the first one.
model EntryAttachment {
  entryId      String
  attachmentId String
  position     Int

  entry      StockEntry @relation(fields: [entryId], references: [id], onDelete: Restrict)
  attachment Attachment @relation(fields: [attachmentId], references: [id], onDelete: Restrict)

  @@id([entryId, attachmentId])
  /// A photo belongs to one entry.
  @@unique([attachmentId])
}

/// Return to supplier follow-up: expected credit and whether it arrived (the entry itself never changes).
model SupplierReturn {
  entryId          String    @id
  expectedCredit   Decimal?  @db.Decimal(12, 2)
  /// SENT | CREDIT_RECEIVED
  status           String    @default("SENT") @db.VarChar(20)
  creditAmount     Decimal?  @db.Decimal(12, 2)
  creditReceivedAt DateTime? @db.DateTime(3)
  updatedById      String
  updatedAt        DateTime  @updatedAt @db.DateTime(3)

  entry     StockEntry @relation(fields: [entryId], references: [id], onDelete: Restrict)
  updatedBy User       @relation(fields: [updatedById], references: [id], onDelete: Restrict)

  @@index([status])
}
