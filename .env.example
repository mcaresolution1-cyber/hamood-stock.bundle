# Copy to .env and fill in real values. Never commit .env.
# On Hostinger, set these same names under the Node.js app's Environment Variables (see README → Deploy).

# MariaDB/MySQL connection: mysql://USER:PASSWORD@HOST:3306/DATABASE
# On Hostinger the host is localhost and the user/database names start with your account prefix (u123456789_…).
# Special characters in the password must be URL-encoded (e.g. @ → %40, # → %23).
DATABASE_URL="mysql://hamood:CHANGE_ME@localhost:3306/hamood_stock"

# Auth.js secret — generate with: openssl rand -base64 32
AUTH_SECRET="CHANGE_ME"

# The app runs behind a proxy (Hostinger, local dev): trust the forwarded host.
AUTH_TRUST_HOST=true

# First admin, created automatically when the database has NO users yet (at server start, or by pnpm db:seed).
# Never used again after that — no account is ever re-created or reset from these. At least 8 characters.
SEED_ADMIN_EMAIL="admin@hamoodtv.local"
SEED_ADMIN_PASSWORD="CHANGE_ME"

# Apply database migrations + base data when the server starts (default true). false = skip.
AUTO_MIGRATE=true

# Add the sample product catalogue when running pnpm db:seed (local development only).
SEED_SAMPLE_PRODUCTS=true
