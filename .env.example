# Copy to .env and fill in real values. Never commit .env.

# PostgreSQL connection string used by the app (on Neon: the POOLED connection string, host contains "-pooler")
DATABASE_URL="postgresql://hamood:CHANGE_ME@localhost:5432/hamood_stock?schema=public"

# Optional: connection used only for migrations (on Neon: the DIRECT connection string). Falls back to DATABASE_URL.
# DIRECT_URL="postgresql://..."

# Auth.js secret — generate with: openssl rand -base64 32
AUTH_SECRET="CHANGE_ME"

# Set to true when running behind a trusted proxy / non-Vercel host (dev, self-hosting)
AUTH_TRUST_HOST=true

# First admin account created by `pnpm db:seed` (only if it doesn't exist yet). At least 8 characters.
SEED_ADMIN_EMAIL="admin@hamoodtv.local"
SEED_ADMIN_PASSWORD="CHANGE_ME"

# Add the sample product catalogue when seeding (local development only — leave false for production)
SEED_SAMPLE_PRODUCTS=true
