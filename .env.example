# Copy to .env and fill in real values. Never commit .env.

# PostgreSQL connection string
DATABASE_URL="postgresql://hamood:CHANGE_ME@localhost:5432/hamood_stock?schema=public"

# Auth.js secret — generate with: openssl rand -base64 32
AUTH_SECRET="CHANGE_ME"

# Set to true when running behind a trusted proxy / non-Vercel host (dev, self-hosting)
AUTH_TRUST_HOST=true

# Password for the seeded admin user (admin@hamoodtv.local)
SEED_ADMIN_PASSWORD="CHANGE_ME"
